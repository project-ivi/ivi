{
  "plugins": [
    "react"
  ],
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "node": false
  },
  "extends": [
    "eslint:recommended"
  ],
  "rules": {
    "indent": ["error", 2],
    "no-console": 0,
    "no-undef": 0,
    "jsx-quotes": ["error", "prefer-single"],
    "quotes": ["error", "single"],
    "semi": ["error", "never"],
    "react/jsx-uses-react": 2,
    "react/jsx-uses-vars": 1
  }
}
